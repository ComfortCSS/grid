{
  "name": "@comfortcss/grid",
  "version": "0.1.0",
  "description": "A modern, accessible, and lightweight CSS grid system for building responsive layouts.",
  "main": "dist/grid.min.css",
  "style": "dist/grid.min.css",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComfortCSS/grid.git"
  },
  "scripts": {
    "build": "npx lightningcss --minify --bundle src/index.css -o dist/grid.min.css",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "css",
    "grid",
    "container",
    "modern",
    "layout",
    "accessible",
    "lightweight"
  ],
  "author": "ComfortCSS",
  "license": "MIT",
  "peerDependencies": {
    "@comfortcss/tokens": "^1.0.0"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "lightningcss-cli": "^1.33.0",
    "@comfortcss/reset": "1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "style": "./dist/grid.min.css",
      "default": "./dist/grid.min.css"
    },
    "./grid": {
      "style": "./dist/grid.min.css",
      "default": "./dist/grid.min.css"
    },
    "./modules/*": "./src/core/*",
    "./package.json": "./package.json"
  }
}
